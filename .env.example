# Скопируйте в .env (он в .gitignore) и заполните. Ключ не коммитить.
LLM_PROVIDER=anthropic          # anthropic | ollama
LLM_MODEL=claude-opus-5-5       # для ollama, например: llama3.1:8b
ANTHROPIC_API_KEY=
# LLM_EFFORT=medium             # low | medium | high (только anthropic)
# MIN_SCORE=                    # порог близости: ниже него отказ без вызова модели
# OLLAMA_URL=http://localhost:11434/api/chat
